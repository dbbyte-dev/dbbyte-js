{
    "name": "@dbbyte/sdk",
    "version": "0.1.2",
    "description": "Official DBByte SDK for JavaScript and TypeScript",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "npm run build && node --test test/api.test.mjs",
        "test:roundtrip": "npm run build && node examples/roundtrip.mjs"
    },
    "devDependencies": {
        "tsup": "^8.0.0",
        "typescript": "^5.4.0"
    },
    "engines": {
        "node": ">=18"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/dbbyte/sdk"
    }
}
