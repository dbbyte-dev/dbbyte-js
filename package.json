{
    "name": "@dbbyte/sdk",
    "version": "0.2.0",
    "description": "Official DBByte SDK for JavaScript and TypeScript",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "npm run build && node --test test/api.test.mjs",
        "test:roundtrip": "npm run build && node examples/roundtrip.mjs",
        "prepublishOnly": "npm test"
    },
    "devDependencies": {
        "tsup": "^8.0.0",
        "typescript": "^5.4.0"
    },
    "engines": {
        "node": ">=18"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dbbyte-dev/dbbyte-js.git"
    },
    "homepage": "https://dbbyte.com/sdk",
    "bugs": {
        "url": "https://github.com/dbbyte-dev/dbbyte-js/issues"
    },
    "keywords": [
        "dbbyte",
        "object-storage",
        "s3",
        "cdn",
        "storage",
        "sdk",
        "typescript"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    }
}
